# Copy to ../.env and fill in. Everything sources this file.
# cp env/.env.example .env && $EDITOR .env

# --- Credentials -------------------------------------------------------------
# NGC personal API key (https://org.ngc.nvidia.com/setup/personal-keys)
# Needs services: "NGC Catalog" + "Private Registry" so `docker login nvcr.io` works.
export NGC_API_KEY="nvapi-CHANGE_ME"

# Hugging Face token. Apertus is Apache-2.0 and ungated, but a token avoids
# anonymous rate limits when several teams pull from the same LaunchPad egress IP.
export HF_TOKEN="hf_CHANGE_ME"

# --- Container images --------------------------------------------------------
# The universal ("any LLM") NIM image. CHECK THE CURRENT TAG on NGC before the
# hackathon: https://catalog.ngc.nvidia.com/orgs/nim/teams/nvidia/containers/llm-nim
export NIM_IMAGE="nvcr.io/nim/nvidia/llm-nim:latest"

# Dynamo runtime image (stretch phase). Pick the backend that actually serves
# Apertus - vllm is the safe bet, sglang is the alternative.
export DYNAMO_IMAGE="nvcr.io/nvidia/ai-dynamo/vllm-runtime:latest"

# --- Models ------------------------------------------------------------------
export APERTUS_8B="swiss-ai/Apertus-8B-Instruct-2509"
export APERTUS_70B="swiss-ai/Apertus-70B-Instruct-2509"

# --- Local paths -------------------------------------------------------------
# Put the cache on the biggest disk you have. 8B ~ 16 GB, 70B ~ 140 GB in bf16.
export CACHE_DIR="${HOME}/nim_cache"
export HF_HOME="${HOME}/hf_cache"
export ARTIFACTS_DIR="${PWD}/artifacts"

# --- Serving defaults --------------------------------------------------------
export NIM_PORT=8000
export TP_SIZE=1
export MAX_MODEL_LEN=8192
