# Copy to ../.env and fill in. Everything sources this file.
# cp env/.env.example .env && $EDITOR .env

# --- Credentials -------------------------------------------------------------
# NGC personal API key (https://org.ngc.nvidia.com/setup/personal-keys)
# Needs services: "NGC Catalog" + "Private Registry" so `docker login nvcr.io` works.
export NGC_API_KEY="nvapi-CHANGE_ME"

# Hugging Face token. REQUIRED for Apertus 1.5: both v1.5 repos are gated behind
# an Acceptable Use Policy click-through. Accept it while logged in to HF BEFORE
# the hackathon, or the download 401s in a way that looks like a bad token.
export HF_TOKEN="hf_CHANGE_ME"

# Swisscom hosted Apertus 1.5 70B, from The Keymaker (see docs/APERTUS-1.5.md §7).
# NOTE: the bearer expires after 60 MINUTES. Long sweeps must refresh it.
export SWISSCOM_API_KEY="CHANGE_ME"
export SWISSCOM_BASE_URL="https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1"
export SWISSCOM_MODEL="swiss-ai/Apertus-v1.5-70B"
# Documented limits - the benchmark scripts enforce these so you don't burn the quota.
export SWISSCOM_MAX_RPS=5
export SWISSCOM_INPUT_BUDGET=10000000
export SWISSCOM_OUTPUT_BUDGET=2500000

# --- Container images --------------------------------------------------------
# Apertus 1.5 needs the Swiss AI vLLM FORK. Upstream vLLM does not know the
# `apertus1p5` architecture yet. Use -arm64 on Grace/GH200.
export APERTUS15_VLLM_IMAGE="ghcr.io/swiss-ai/vllm_apertus_1.5_release:latest-amd64"

# Universal ("any LLM") NIM image - used for the Apertus 1.0 leg and for the
# documented v1.5 compatibility attempt. Check the current tag on NGC:
# https://catalog.ngc.nvidia.com/orgs/nim/teams/nvidia/containers/llm-nim
export NIM_IMAGE="nvcr.io/nim/nvidia/llm-nim:latest"

# Dynamo runtime (stretch). For v1.5 you must BUILD on top of the fork - see
# dynamo/33_build_apertus_image.sh. This default only works for the 1.0 leg.
export DYNAMO_IMAGE="nvcr.io/nvidia/ai-dynamo/vllm-runtime:latest"

# --- Models ------------------------------------------------------------------
# PRIMARY - the study is about 1.5.
export APERTUS15_8B="swiss-ai/Apertus-v1.5-8B"
export APERTUS15_70B="swiss-ai/Apertus-v1.5-70B"
# Reference leg only: 1.0 is what NIM may actually be able to load.
export APERTUS10_8B="swiss-ai/Apertus-8B-Instruct-2509"
export APERTUS10_70B="swiss-ai/Apertus-70B-Instruct-2509"

# --- Local paths -------------------------------------------------------------
# 8B ~18 GB, 70B ~140 GB. Put the cache on the biggest disk you have.
export CACHE_DIR="${HOME}/nim_cache"
export HF_HOME="${HOME}/hf_cache"
export ARTIFACTS_DIR="${PWD}/artifacts"

# --- Serving defaults --------------------------------------------------------
export NIM_PORT=8000
export TP_SIZE=1
# The model's native context is 262144. Serving it costs enormous KV memory -
# sweeping this is the single biggest lever in the study. Start small.
export MAX_MODEL_LEN=8192
# The 1.5 model card uses 0.6 for the 8B (multimodal encoders + huge KV need
# headroom), not the usual 0.9. Raising it is a lever; it OOMs fast.
export GPU_MEM_UTIL=0.6
export ENABLE_THINKING=0
